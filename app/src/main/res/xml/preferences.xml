<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_categorie_affichage">

        <!-- Les valeurs par défaut doivent rester identiques à celles de PreferencesManager -->
        <ListPreference
            app:key="taille_police"
            app:title="@string/pref_taille_police"
            app:entries="@array/tailles_libelles"
            app:entryValues="@array/tailles_valeurs"
            app:defaultValue="16"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="couleur_preferee"
            app:title="@string/pref_couleur"
            app:entries="@array/couleurs_libelles"
            app:entryValues="@array/couleurs_valeurs"
            app:defaultValue="#000000"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_categorie_liste">

        <SwitchPreferenceCompat
            app:key="appel_depuis_liste"
            app:title="@string/pref_appel_titre"
            app:summaryOn="@string/pref_appel_resume_on"
            app:summaryOff="@string/pref_appel_resume_off"
            app:defaultValue="false" />
    </PreferenceCategory>

</PreferenceScreen>
